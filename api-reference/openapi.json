{
  "components": {
    "schemas": {
      "ClaimIn": {
        "description": "What an agent submits. Always untrusted (SPEC §2).",
        "properties": {
          "action": {
            "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+){2}$",
            "title": "Action",
            "type": "string"
          },
          "agent_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Agent Id",
            "type": "string"
          },
          "claimed_at": {
            "format": "date-time",
            "title": "Claimed At",
            "type": "string"
          },
          "client_claim_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Claim Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "target": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "client_claim_id",
          "agent_id",
          "action",
          "target",
          "claimed_at"
        ],
        "title": "ClaimIn",
        "type": "object"
      },
      "Error": {
        "properties": {
          "detail": {
            "description": "What went wrong, in plain words.",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Error",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "description": "A workspace API key, created on the Developers screen.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The public HTTP API of QED Proof. Guides: https://docs.qedproof.site",
    "title": "QED Proof API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/poaw-keys.json": {
      "get": {
        "description": "The receipt-signing public keys, and the anchor attesters and schemas a checker must accept (SPEC §5.2, §8.4). Public by design.",
        "operationId": "poaw_keys__well_known_poaw_keys_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Poaw Keys  Well Known Poaw Keys Json Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get the public keys"
      }
    },
    "/v1/claims": {
      "get": {
        "description": "This workspace's claims, newest first. Each item has the same shape as Get a claim. Pass the returned `next_cursor` as `cursor` for the next page (it's null on the last page). Filter by `agent_id`, `action`, `verdict` or `state` (`queued` | `decided`).",
        "operationId": "list_claims_v1_claims_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "agent_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent Id"
            }
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "in": "query",
            "name": "verdict",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Verdict"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Claims V1 Claims Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Malformed cursor."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid API key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List claims"
      },
      "post": {
        "description": "Tells QED Proof what an agent says it did. The claim is checked against the destination itself, inline when the destination answers quickly, otherwise by the next worker pass. Submitting the same `client_claim_id` again returns the existing claim (`created: false`) instead of a second one.",
        "operationId": "submit_v1_claims_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit V1 Claims Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid API key."
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The deployment refused a new claim (for example a workspace limit). Nothing was created."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request body is too large."
          },
          "422": {
            "description": "The claim or its `params` are invalid for this `action`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded. Retry after the `Retry-After` header's seconds."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Submit a claim"
      }
    },
    "/v1/claims/{claim_id}": {
      "get": {
        "description": "The claim's current status and, once decided, its verdict and receipt id.",
        "operationId": "claim_status_v1_claims__claim_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "title": "Claim Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Claim Status V1 Claims  Claim Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid API key."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such claim in this workspace."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Get a claim"
      }
    },
    "/v1/connections": {
      "get": {
        "description": "The destinations this workspace has connected read-only, and what QED Proof can verify through each: `actions` lists the verifier actions available for that connection's provider (an empty list means connected, but no verifier is live yet). `public_actions` need no connection. Active connections only, oldest first. To protect the connected accounts, no account names or IDs are returned; the console shows those to signed-in members. Connecting and disconnecting happen in the console.",
        "operationId": "list_connections_v1_connections_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Connections V1 Connections Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid API key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List connections"
      }
    },
    "/v1/log/anchors": {
      "get": {
        "description": "Landed anchors of the log root on Base Sepolia (testnet), newest first, with EAS uid, transaction, block and time. Pass `next` as `before` for older ones. Free and public.",
        "operationId": "log_anchors_v1_log_anchors_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Log Anchors V1 Log Anchors Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid parameters."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "List anchors"
      }
    },
    "/v1/log/consistency": {
      "get": {
        "description": "Proves the tree of size `first` is a prefix of the tree of size `second` (RFC 6962 / 9162): every entry that was in the log is still there, unchanged. Free and public.",
        "operationId": "log_consistency_v1_log_consistency_get",
        "parameters": [
          {
            "in": "query",
            "name": "first",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "First",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "second",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "Second",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Log Consistency V1 Log Consistency Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid sizes (`first` must be ≤ `second`)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`second` is beyond the current tree size."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get a consistency proof"
      }
    },
    "/v1/log/entries": {
      "get": {
        "description": "Entries of the log in order: leaf index, leaf hash and time only, never receipt ids or contents, so nobody's claims can be enumerated. A receipt holder proves their own entry with the receipt. Defaults to the newest 50; pass `start` for a range. Free and public.",
        "operationId": "log_entries_v1_log_entries_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Log Entries V1 Log Entries Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid parameters."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`start` is beyond the current tree size."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "List log entries"
      }
    },
    "/v1/log/head": {
      "get": {
        "description": "The log's current size and root, signed by QED Proof's receipt key under its own domain (`POAW-TREE-HEAD-V0`, SPEC §8.5), plus the latest anchor on Base Sepolia (testnet) with its block. Free and public: no key, any site may call it from a browser. Compare heads over time with Get a consistency proof to confirm nothing was rewritten.",
        "operationId": "log_head_v1_log_head_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Log Head V1 Log Head Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get the signed tree head"
      }
    },
    "/v1/log/proof": {
      "get": {
        "description": "Proves the leaf at `leaf_index` is in the tree of size `tree_size` (default: the current size), with its leaf hash and the root. A receipt already carries one; use this to prove it against a newer head. Free and public.",
        "operationId": "log_proof_v1_log_proof_get",
        "parameters": [
          {
            "in": "query",
            "name": "leaf_index",
            "required": true,
            "schema": {
              "minimum": 0,
              "title": "Leaf Index",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "tree_size",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tree Size"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Log Proof V1 Log Proof Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid parameters."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such leaf in a tree of that size."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get an inclusion proof"
      }
    },
    "/v1/receipts/{receipt_id}": {
      "get": {
        "description": "A signed receipt with its inclusion proof in the log (and the anchor with its block, once the log root is anchored). Receipts are meant to be shared and checked by anyone, so this needs no API key. Reads are rate-limited per API key when a valid key is sent, otherwise per IP address.",
        "operationId": "receipt_v1_receipts__receipt_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "receipt_id",
            "required": true,
            "schema": {
              "title": "Receipt Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Receipt V1 Receipts  Receipt Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such receipt."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get a receipt"
      }
    },
    "/v1/whoami": {
      "get": {
        "description": "Says which workspace a credential belongs to, and what it may do: `kind` is `key` for an API key (full access, `scopes` is null) or `oauth` for a token from the sign-in flow (limited `scopes`, and the `audience` it was issued for). Any valid credential may ask. Servers that accept QED Proof credentials use this to check one.",
        "operationId": "whoami_v1_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Whoami V1 Whoami Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid credential."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
